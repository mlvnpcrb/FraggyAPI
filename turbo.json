{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["API_BASE_URL"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": [],
      "cache": false,
      "passThroughEnv": ["PYTEST_ADDOPTS"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "@fraggy/api#build": {
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "MIGRATION_DATABASE_URL",
    "APP_ENV",
    "CORS_ORIGINS",
    "RUN_DB_TESTS",
    "DATABASE_TIMEOUT_SECONDS",
    "NEXT_TELEMETRY_DISABLED",
    "TURBO_TELEMETRY_DISABLED",
    "API_BASE_URL",
    "CATALOG_INCLUDE_SYNTHETIC"
  ],
  "globalDependencies": ["ruff.toml"]
}
