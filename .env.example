# Local-only disposable development credentials; never use in production.
POSTGRES_USER=fraggy
POSTGRES_PASSWORD=fraggy_local_only
POSTGRES_DB=fraggy
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://fraggy:fraggy_local_only@127.0.0.1:5432/fraggy
# Optional direct/session-pooler URL for migrations (do not use transaction pooler).
# MIGRATION_DATABASE_URL=postgresql+asyncpg://...
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Server-side Next.js public API client. No browser credentials.
API_BASE_URL=http://127.0.0.1:8000/api/v1
# Opt-in development fixtures only; production always excludes synthetic grants.
CATALOG_INCLUDE_SYNTHETIC=false
